# Copy to .env and fill in real values. Never commit .env.

# Required
OPENAI_API_KEY=your-openai-key-here
# Search: SerpApi is used first; Serper.dev takes over when SerpApi's quota runs out.
# At least one is required.
SERPAPI_API_KEY=your-serpapi-key-here
SERPER_API_KEY=your-serper-key-here

# Models per stage (Stage 1-2 use MODEL_DEFAULT; Stage 3-4 use MODEL_STRATEGY)
MODEL_DEFAULT=gpt-4o-mini
MODEL_STRATEGY=gpt-4o-mini

# Keep framework telemetry and console banners off
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false

# Optional: if set, visitors must enter this code before using the app
ACCESS_CODE=

# Usage caps
MAX_RUNS_PER_SESSION=3
DAILY_RUN_CAP=20
MAX_CONCURRENT_RUNS=2
MAX_SEARCHES_PER_RUN=15
MAX_PAGE_FETCHES_PER_RUN=15
MAX_LLM_CALLS_PER_RUN=60
RUN_TIMEOUT_SECONDS=480
