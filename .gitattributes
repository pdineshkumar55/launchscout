# Files that run on Linux (VPS / Docker) must keep LF line endings even when committed from Windows.
*.sh               text eol=lf
Dockerfile         text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf
*.conf             text eol=lf
*.toml             text eol=lf
.dockerignore      text eol=lf
.env.example       text eol=lf

*.pdf binary
*.png binary
*.jpg binary
